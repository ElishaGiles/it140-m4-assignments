# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    # Establish a valid guessing range.
    Display "Enter the lower bound: "
    Input lower_bound
    Display "Enter the upper bound: "
    Input upper_bound
    WHILE lower_bound is greater than or equal to upper_bound
        Display "Invalid entry. The lower bound must be less than the upper bound."
        Re-Display "Enter the lower bound: "
        Input lower_bound
        Re-Display "Enter the upper bound: "
    END WHILE

    # Establish the number the player is trying to guess.
    Generate a random number in the range between lower_bound and upper_bound
    Store random number in variable random_number

    # Play the game.
    Display "Enter your guess between the lower and upper bounds: "
    Input guess
    WHILE guess is less than lower_bound OR is greater than upper_bound
        Display: "Your input guess is not within the set bounds. Please try again."
        Input guess
    END WHILE

    WHILE guess is not equal to random_number
        IF guess is less than random_number
            Display "Your guess is too low."
        ELSE IF guess is greater than random_number
            Display "Your guess is too high."
        ELSE
            Display "Congrats! You got it right!"
        END IF

        IF guess is not equal to random_number
            Display "Guess again: "
            Input guess

            WHILE guess is less than lower_bound OR greater than upper_bound
                Display "Your input guess is not within the set bounds. Please try again."
                Input guess
            END WHILE
        END IF
    END WHILE
END hilow_game

